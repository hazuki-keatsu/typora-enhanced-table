{
	"compilerOptions": {
		"types": ["jquery", "node"],
		"target": "ESNext",
		"module": "ESNext",
		"allowJs": true,
		"resolveJsonModule": true,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
